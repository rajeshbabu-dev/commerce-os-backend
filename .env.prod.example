# =============================================================================
# CommerceOS Backend — Production Environment Variables (.env.prod)
# =============================================================================
# Active Profile
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Production Database (Neon / Supabase PostgreSQL)
PROD_DB_URL=jdbc:postgresql://<NEON_HOST>:5432/<NEON_DB>?sslmode=require
PROD_DB_USERNAME=<NEON_USER>
PROD_DB_PASSWORD=<NEON_PASSWORD>
PROD_DB_POOL_MAX_SIZE=10
PROD_DB_POOL_MIN_IDLE=2

# Production Redis (Upstash Serverless Redis)
PROD_REDIS_HOST=<UPSTASH_ENDPOINT>
PROD_REDIS_PORT=6379
PROD_REDIS_PASSWORD=<UPSTASH_PASSWORD>
PROD_REDIS_SSL=true

# Production RabbitMQ (CloudAMQP)
PROD_RABBITMQ_HOST=<CLOUDAMQP_HOST>
PROD_RABBITMQ_PORT=5672
PROD_RABBITMQ_USERNAME=<CLOUDAMQP_USER>
PROD_RABBITMQ_PASSWORD=<CLOUDAMQP_PASSWORD>
PROD_RABBITMQ_VIRTUAL_HOST=<CLOUDAMQP_USER>
PROD_RABBITMQ_SSL=false

# Security & CORS
PROD_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
PROD_JWT_ACCESS_TOKEN_TTL=15m
PROD_JWT_REFRESH_TOKEN_TTL=7d
PROD_CORS_ALLOWED_ORIGINS=https://*.vercel.app,http://localhost:*,http://127.0.0.1:*

# Optional AI / LLM Key
PROD_LLM_PROVIDER=claude
PROD_LLM_API_KEY=your-anthropic-api-key
