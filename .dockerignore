# =============================================================================
# CommerceOS Backend — .dockerignore
# =============================================================================
# Excludes files that should NOT be sent to the Docker daemon during build.
# This speeds up builds and prevents leaking secrets or build artifacts.
# =============================================================================

# Git
.git
.gitignore

# IDE
.idea
.vscode
*.iml
*.ipr
*.iws

# Build output (rebuilt inside container)
target/

# Maven
.mvn/wrapper/maven-wrapper.jar

# Environment files (secrets)
.env
.env.*
!.env.example

# Docker
docker-compose*.yml
Dockerfile*
.dockerignore

# Documentation
*.md
LICENSE

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Node (if accidentally placed in backend)
node_modules
