# =============================================================================
# CommerceOS Backend — Staging Environment Variables (.env.stage)
# =============================================================================
# Active Profile
SPRING_PROFILES_ACTIVE=stage
SERVER_PORT=8080

# Staging Database (Staging Neon / Supabase PostgreSQL)
STAGE_DB_URL=jdbc:postgresql://<STAGE_NEON_HOST>:5432/<STAGE_NEON_DB>?sslmode=require
STAGE_DB_USERNAME=<STAGE_NEON_USER>
STAGE_DB_PASSWORD=<STAGE_NEON_PASSWORD>
STAGE_DB_POOL_MAX_SIZE=10
STAGE_DB_POOL_MIN_IDLE=2

# Staging Redis (Staging Upstash Redis)
STAGE_REDIS_HOST=<STAGE_UPSTASH_ENDPOINT>
STAGE_REDIS_PORT=6379
STAGE_REDIS_PASSWORD=<STAGE_UPSTASH_PASSWORD>
STAGE_REDIS_SSL=true

# Staging RabbitMQ (Staging CloudAMQP)
STAGE_RABBITMQ_HOST=<STAGE_CLOUDAMQP_HOST>
STAGE_RABBITMQ_PORT=5672
STAGE_RABBITMQ_USERNAME=<STAGE_CLOUDAMQP_USER>
STAGE_RABBITMQ_PASSWORD=<STAGE_CLOUDAMQP_PASSWORD>
STAGE_RABBITMQ_VIRTUAL_HOST=<STAGE_CLOUDAMQP_USER>
STAGE_RABBITMQ_SSL=false

# Security & CORS
STAGE_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
STAGE_JWT_ACCESS_TOKEN_TTL=15m
STAGE_JWT_REFRESH_TOKEN_TTL=7d
STAGE_CORS_ALLOWED_ORIGINS=https://*.vercel.app,http://localhost:*,http://127.0.0.1:*

# Optional AI / LLM Key
STAGE_LLM_PROVIDER=claude
STAGE_LLM_API_KEY=your-anthropic-api-key
